##
# Need
#
# Need is a Runtime Domain Layer object representing an active
# market opportunity generated by the Market system.
#
# Need is created from a NeedDefinition and contains the specific
# attribute targets that customers are currently seeking.
#
# Examples:
# - High Strength Construction Bracket
# - Low Cost Agricultural Mount
# - Corrosion Resistant Utility Plate
#
# Need is the starting point of the business pipeline:
#
# Need
#   ↓
# Sample Submission
#   ↓
# Contract
#   ↓
# Order
#
# Needs do not evaluate products directly.
# Needs do not generate contracts directly.
# These responsibilities belong to MarketService.
#
# Need simply represents a market opportunity currently available
# to the player.
##

class_name Need
extends RefCounted

# ------------------------------------------------------------------
# Identity
# ------------------------------------------------------------------

var need_id: int = 0

var need_definition: NeedDefinition = null

var need_name: String = ""

# ------------------------------------------------------------------
# Market Information
# ------------------------------------------------------------------

var industry_definition: IndustryDefinition = null

# ------------------------------------------------------------------
# Generated Target Values
# ------------------------------------------------------------------

# Generated runtime targets.
#
# Example:
# {
#     "Strength": 85.0,
#     "Cost": 20.0
# }
var target_attributes: Dictionary = {}

# ------------------------------------------------------------------
# Lifecycle
# ------------------------------------------------------------------

# Time generated according to MasterClock.
var creation_time: float = 0.0

# Time when this Need expires.
var expiration_time: float = 0.0

var is_active: bool = true

# ------------------------------------------------------------------
# Market Value
# ------------------------------------------------------------------

# Relative attractiveness of this Need.
#
# Higher values generally result in larger contracts
# and more profitable opportunities.
var market_value: float = 1.0

# ------------------------------------------------------------------
# Attribute Functions
# ------------------------------------------------------------------

# Returns a target attribute value.
#
# Returns 0.0 if the attribute is not required.
func get_target_attribute(attribute_name: String) -> float:
        return target_attributes.get(attribute_name, 0.0)


# Returns true if this Need specifies a target value
# for the supplied attribute.
func requires_attribute(attribute_name: String) -> bool:
        return target_attributes.has(attribute_name)


# Returns a list of required attribute names.
func get_required_attributes() -> Array[String]:

        var attribute_names: Array[String] = []

        for attribute_name in target_attributes.keys():
                attribute_names.append(attribute_name)

        return attribute_names

# ------------------------------------------------------------------
# Lifecycle Functions
# ------------------------------------------------------------------

# Returns true if the Need has expired.
func is_expired(current_time: float) -> bool:
        return current_time >= expiration_time


# Updates active state based on current time.
func update_status(current_time: float) -> void:

        if is_expired(current_time):
                is_active = false


# Returns remaining time before expiration.
func get_remaining_time(current_time: float) -> float:
        return max(expiration_time - current_time, 0.0)

# ------------------------------------------------------------------
# Validation Functions
# ------------------------------------------------------------------

# Returns true if the Need references a valid definition.
func has_valid_definition() -> bool:
        return need_definition != null


# Returns true if the Need contains at least one target attribute.
func has_targets() -> bool:
        return not target_attributes.is_empty()


# Returns true if the Need is properly configured.
func is_valid_need() -> bool:

        if not has_valid_definition():
                return false

        if not has_targets():
                return false

        return true

# ------------------------------------------------------------------
# Debug Functions
# ------------------------------------------------------------------

# Returns a human-readable summary useful for UI
# displays and debugging.
func get_summary() -> String:

        return "%s | Attributes: %d | Active: %s" % [
                need_name,
                target_attributes.size(),
                str(is_active)
        ]
